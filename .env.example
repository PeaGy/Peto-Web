# Sao chep thanh .env khi can. KHONG commit file .env.
# Day la cau hinh RIENG cua Peto Web — khong sao chep tu .env cua bot Discord.

# ---------------------------------------------------------------------------
# Nha cung cap AI
# ---------------------------------------------------------------------------
# "mock" = tra loi gia, khong goi mang. "xai" = Grok that qua OAuth.
PETO_AI_PROVIDER=xai

# XAI_MODEL=grok-4.7
# XAI_BASE_URL=https://api.x.ai/v1
# Tìm web ngay trong chat, dùng kết nối xAI hiện có; có thể phát sinh phí công cụ.
# PETO_WEB_SEARCH_ENABLED=true
# XAI_MAX_OUTPUT_TOKENS=8192
# Gioi han phan hoi AI (token), khong phai gioi han ky tu tin nhan Discord.

# Token xAI RIENG cua web. Khong tro vao .xai_tokens.json cua bot Discord.
# PETO_XAI_TOKEN_PATH=backend/data/xai_tokens.json

# Fallback pay-as-you-go khi khong dung OAuth. De trong neu da dang nhap OAuth.
# XAI_API_KEY=

# ---------------------------------------------------------------------------
# OpenAI: 6 Luna tren web va trong Peto Agent; 5.6 Terra va 6 Sol chi trong Peto Agent, chi chu web
# ---------------------------------------------------------------------------
# Khóa API OpenAI, tính tiền vào billing API. Để trống thì chỉ có Peto. Không bao giờ gửi xuống trình duyệt hay CLI.
# OPENAI_API_KEY=
# 6 Luna: mọi tài khoản Discord/Google (khách chỉ dùng Peto). 5.6 Terra và 6 Sol: chỉ các tài khoản dưới đây.
# Dạng discord:<Discord ID> hoặc google:<mã Google>, ngăn cách bằng dấu phẩy; chỉ ghi số thì hiểu là Discord ID.
# PETO_OWNER_ACCOUNTS=
# Giới hạn token mỗi lượt trả lời của model OpenAI, tính cả phần suy nghĩ.
# PETO_OPENAI_MAX_OUTPUT_TOKENS=16000

# ---------------------------------------------------------------------------
# Dang nhap Discord (bat buoc — khong co thi khong ai vao duoc)
# ---------------------------------------------------------------------------
# Lay tai https://discord.com/developers/applications > OAuth2.
# Nho them dung Redirect URI ben duoi vao muc OAuth2 > Redirects cua app.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback

# --- Dang nhap Google (tuy chon) ---
# Tao OAuth client tai https://console.cloud.google.com/apis/credentials
# (loai "Web application"), them Authorized redirect URI khop GOOGLE_REDIRECT_URI.
# Thieu mot trong hai gia tri thi nut Google tu an, khong hong cach dang nhap khac.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# LUU Y: PETO_ALLOWED_DISCORD_IDS da bi go bo. Dang ky gio la MO — bat ky ai
# mo duoc dia chi deu dung duoc va deu tieu quota AI cua may chu. Khai bien do
# khong con tac dung gi.

# Khoa ky cookie phien. Bat buoc dat khi deploy — doi khoa = dang xuat tat ca.
# Sinh khoa: python -c "import secrets; print(secrets.token_urlsafe(32))"
PETO_SESSION_SECRET=

# Noi dua nguoi dung ve sau khi dang nhap Discord xong.
# DE TRONG la tot nhat: backend chuyen huong bang duong dan tuong doi nen
# luon quay lai dung domain vua den. Chi dat khi frontend o domain KHAC.
# PETO_FRONTEND_URL=
# PETO_SESSION_MAX_AGE=2592000
# Bat khi chay HTTPS that.
# PETO_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Tri nho tu bot Discord (mot chieu, chi doc)
# ---------------------------------------------------------------------------
# Chi hoat dong khi bot bat Memory Gateway (MEMORY_GATEWAY_TOKEN ben repo bot).
# Token phai KHOP voi ben bot. De trong = tat, web van chat binh thuong nhung
# Peto se khong nho gi tu Discord.
# PETO_MEMORY_GATEWAY_URL=http://127.0.0.1:8766
# PETO_MEMORY_GATEWAY_TOKEN=
# PETO_MEMORY_GATEWAY_TIMEOUT=3
# Moi luot chat deu hoi lai gateway; PETO_MEMORY_CACHE_TTL cu khong con duoc su dung.

# ---------------------------------------------------------------------------
# Luu tru va gioi han tai
# ---------------------------------------------------------------------------
# PETO_WEB_DB=backend/data/peto_web.db
# PETO_MAX_CONCURRENT=3
# PETO_MAX_QUEUE=6
# PETO_QUEUE_TIMEOUT_SECONDS=60
# PETO_COOLDOWN_SECONDS=3

# PETO_TIMEOUT_LOW_SECONDS=180
# PETO_TIMEOUT_MEDIUM_SECONDS=300
# PETO_TIMEOUT_HIGH_SECONDS=480

# PETO_MAX_HISTORY=20
# Số tin cũ gửi cho AI ở hội thoại chế độ nhập vai (2-300); nhiều tin thì giữ mạch dài hơn nhưng tốn token hơn.
# PETO_ROLEPLAY_MAX_HISTORY=100
# PETO_MAX_INPUT_CHARS=32000
# Đọc tài liệu: số trang PDF, chữ mỗi tệp, tổng chữ gửi AI và thời gian mỗi tệp.
# PETO_MAX_DOCUMENT_PAGES=100
# PETO_MAX_TEXT_EXCERPT_CHARS=80000
# PETO_MAX_DOCUMENT_CONTEXT_CHARS=160000
# PETO_DOCUMENT_TIMEOUT=15
# Mui gio du phong khi trinh duyet khong cung cap; dung ten IANA.
# PETO_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
# PETO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Peto tao anh: ten hien thi la Peto, model phai giu dung slug cua dich vu.
# PETO_IMAGINE_MODEL=grok-imagine-image-2.0
# PETO_IMAGINE_TIMEOUT_SECONDS=90
# PETO_MAX_IMAGINE_N=4
# PETO_MAX_IMAGINE_PROMPT_CHARS=2000
# Anh goc de chinh sua: toi da 8 MB (PNG, JPEG, WebP).
# PETO_MAX_IMAGINE_SOURCE_BYTES=8388608

# ---------------------------------------------------------------------------
# Giọng nói Peto từ máy Windows (voice-worker)
# ---------------------------------------------------------------------------
# Khóa bí mật để relay trên máy Windows nhận việc từ /api/voice. Để trống thì giọng nói
# luôn báo ngoại tuyến, chat chữ vẫn chạy. Cần ít nhất 32 ký tự và nhập đúng khóa này khi
# chạy voice-worker/start-relay.ps1. Không đưa khóa vào frontend hay Git.
# PETO_VOICE_SERVER_URL đặt trên máy Windows, không đặt ở đây. Backend phải chạy một tiến
# trình vì hàng chờ giọng nói nằm trong RAM. Xem voice-worker/README.md.
# Sinh khóa: python -c "import secrets; print(secrets.token_urlsafe(32))"
# PETO_VOICE_WORKER_TOKEN=

# ---------------------------------------------------------------------------
# Peto Agent (CLI trên máy người dùng, xem agent-cli/README.md)
# ---------------------------------------------------------------------------
# CLI giữ vòng lặp và chạy công cụ ngay trên máy người dùng; máy chủ chỉ xác thực, đếm bước và gọi mô hình.
# Tài khoản khách không dùng được. Mã đăng nhập đang chờ nằm trong RAM, nên backend chạy một tiến trình.
# Đặt PETO_FRONTEND_URL là địa chỉ tuyệt đối thì liên kết đăng nhập in ra có sẵn domain; không thì CLI tự ghép.
# Mô hình cho agent; để trống thì dùng XAI_MODEL.
# PETO_AGENT_MODEL=
# Mức suy nghĩ mặc định (low | medium | high) khi người dùng chưa chọn bằng /effort trong CLI. Mức high tính 2 bước.
# PETO_AGENT_REASONING=medium
# Số bước mỗi ngày cho mỗi tài khoản; mỗi lần gọi mô hình là một bước. Chỉ áp cho agent, chat không giới hạn lượt.
# PETO_AGENT_DAILY_STEPS=200
# Hàng chờ riêng của agent, không chiếm suất chạy của chat.
# PETO_AGENT_MAX_CONCURRENT=2
# PETO_AGENT_MAX_QUEUE=4
# Dung lượng tối đa của một bước CLI gửi lên, gồm cả hội thoại và ảnh gửi kèm (CLI giữ tối đa 4 ảnh, mỗi ảnh dưới 2 MB).
# PETO_AGENT_MAX_REQUEST_BYTES=16777216
# PETO_AGENT_STEP_TIMEOUT_SECONDS=300
# Token của máy không dùng quá số ngày này thì hết hiệu lực.
# PETO_AGENT_TOKEN_IDLE_DAYS=30
# Cho agent tìm web (chạy ở phía dịch vụ AI, tính phí theo lượt tìm). PETO_WEB_SEARCH_ENABLED=false thì cũng tắt theo.
# PETO_AGENT_WEB_SEARCH=true
# Bước lâu hơn ngần này giây thì ghi một dòng cảnh báo kèm thời gian chờ dịch vụ AI, để tìm nguyên nhân bước chậm.
# PETO_AGENT_SLOW_STEP_SECONDS=20

# Cloud TTS: explicitly enable on VPS. Reuses OPENAI_API_KEY; no changes to chat models.
PETO_TTS_OPENAI_ENABLED=false
# Supported: tts-1 ($15 / 1M chars), tts-1-hd ($30 / 1M chars).
PETO_TTS_OPENAI_MODEL=tts-1
PETO_TTS_QWEN_ENABLED=false
DASHSCOPE_API_KEY=
PETO_TTS_QWEN_MODEL=qwen3-tts-flash
PETO_TTS_QWEN_VOICES=Cherry,Serena
# For cloned voices: model=qwen3-tts-vc-2026-01-22; voices=comma-separated matching enrollment IDs.
# PETO_TTS_QWEN_ENDPOINT=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# Estimated API spend ceiling for ALL users/providers, UTC month; excludes taxes and other apps.
PETO_TTS_MONTHLY_USD=10
